        "paymentGatewayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Paid", "Pending", "Failed", "Refunded"],
          "minLength": 1,
          "maxLength": 30

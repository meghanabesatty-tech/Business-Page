        "orderStatus": {
          "type": "string",
          "enum": [
            "Order Placed",
            "Payment Confirmed",
            "Preparing",
            "Shipped",
            "Out for Delivery",
            "Delivered",
            "Cancelled"
          ],
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderNumber",
        "userId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "shippingAddress",
        "itemsSummary",
        "subtotal",
        "discountAmount",
        "couponCode",
        "shippingCost",
        "totalAmount",
        "paymentMethod",
        "paymentGatewayId",
        "paymentStatus",
        "orderStatus",
        "createdAt",
        "updatedAt"
      ]

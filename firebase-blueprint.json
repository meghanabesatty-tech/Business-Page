  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Trusted admin lookup collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public-safe user profile documents"
    },
    "/users_private/{userId}": {
      "schema": "UserPrivateInfo",
      "description": "Isolated PII contact details for users"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Storefront product categories"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Storefront handmade product listings"
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User shopping cart root document"
    },
    "/carts/{userId}/items/{itemId}": {
      "schema": "CartItem",
      "description": "Subcollection of cart line items for a user"
    },
    "/wishlists/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "Customer saved wishlist items"
    },
    "/addresses/{addressId}": {
      "schema": "SavedAddress",
      "description": "Customer saved shipping addresses"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": "OrderItem",
      "description": "Subcollection of line items belonging to an order"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer product reviews"
    },
    "/custom_requests/{requestId}": {
      "schema": "CustomArtRequest",
      "description": "Bespoke custom artwork requests"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount coupons"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer contact inquiries"
    }
  }
}
